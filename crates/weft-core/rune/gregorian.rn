// 公历日期分量：[年, 月, 日, 时, 分, 秒]。历算与本地化展示分开。
pub fn meta(ctx) {
    let zh = ctx.language == "zh";
    #{
        id: "gregorian",
        name: if zh { "格里高利历" } else { "Gregorian Calendar" },
        description: if zh {
            "采用年、月、日和时分秒表示时间，并包含公历闰年规则。"
        } else {
            "Represents time with years, months, days, hours, minutes, and seconds."
        },
        components: 6,
        minimums: [0, 1, 1, 0, 0, 0],
    }
}

// 反算 tick；用整段日期换算处理跨月、跨年及负的时分秒。
pub fn from_tick(tick) {
    // 历算以三月为年首；将零年一月一日原点移回三月基准。
    let tick = tick - 60 * 86400;
    let days = tick / 86400;
    let seconds = tick % 86400;
    if seconds < 0 {
        days -= 1;
        seconds += 86400;
    }
    let era = if days >= 0 { days / 146097 } else { (days - 146096) / 146097 };
    let doe = days - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let year = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    let month = mp + if mp < 10 { 3 } else { -9 };
    year += if month <= 2 { 1 } else { 0 };
    [year, month, day, seconds / 3600, seconds % 3600 / 60, seconds % 60]
}

// 日期相对原点的秒数。全零数组和 [0, 1, 1, 0, 0, 0] 对应 0。
// 两个日期的刻度相减得到间隔秒数；除以 86400 得到相差天数。
pub fn to_tick(values) {
    let year = values[0];
    // 缺省月、日按一月一日计算。
    let month = values[1];
    let day = values[2];
    let hour = values[3];
    let minute = values[4];
    let second = values[5];

    let raw_month_idx = (month - 1) % 12;
    let month_idx = if raw_month_idx < 0 { raw_month_idx + 12 } else { raw_month_idx };
    let year_carry = ((month - 1) - month_idx) / 12;
    year += year_carry;
    let month = month_idx + 1;

    let total_seconds = hour * 3600 + minute * 60 + second;
    let day_carry = total_seconds / 86400;
    let seconds = total_seconds % 86400;

    let adjusted_year = year - if month <= 2 { 1 } else { 0 };
    let era = if adjusted_year >= 0 {
        adjusted_year / 400
    } else {
        (adjusted_year - 399) / 400
    };
    let yoe = adjusted_year - era * 400;
    let shifted_month = month + if month > 2 { -3 } else { 9 };
    let doy = (153 * shifted_month + 2) / 5;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy + day - 1 + day_carry;
    (era * 146097 + doe + 60) * 86400 + seconds
}

// 只格式化归一化日期；precision 保留作者输入的模糊程度。
pub fn humanizer(ctx) {
    let value = ctx.values;
    let precision = ctx.precision;
    let lang = ctx.language;
    let year = value[0];
    let month = value[1];
    let day = value[2];
    let hour = value[3];
    let minute = value[4];
    let second = value[5];
    if lang == "zh" {
        let date = if precision <= 1 { `${year}年` } else if precision == 2 { `${year}年${month}月` } else { `${year}年${month}月${day}日` };
        if hour == 0 && minute == 0 && second == 0 { return date; }
        let stamp = `${date}${hour}时${minute}分${second}秒`;
        return stamp;
    }
    let months = ["Jan.", "Feb.", "Mar.", "Apr.", "May", "Jun.", "Jul.", "Aug.", "Sep.", "Oct.", "Nov.", "Dec."];
    let date = if precision <= 1 { `${year}` } else if precision == 2 { `${months[month - 1]} ${year}` } else { `${months[month - 1]} ${day}, ${year}` };
    if hour == 0 && minute == 0 && second == 0 { return date; }
    let hh = if hour < 10 { `0${hour}` } else { `${hour}` };
    let mm = if minute < 10 { `0${minute}` } else { `${minute}` };
    let ss = if second < 10 { `0${second}` } else { `${second}` };
    `${date}, ${hh}:${mm}:${ss}`
}

fn is_leap_year(year) {
    (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
}

fn days_in_month(year, month) {
    if month == 2 {
        if is_leap_year(year) { 29 } else { 28 }
    } else if month == 4 || month == 6 || month == 9 || month == 11 {
        30
    } else {
        31
    }
}

fn diff_components(a, b) {
    let diff_secs = (b[3] * 3600 + b[4] * 60 + b[5]) - (a[3] * 3600 + a[4] * 60 + a[5]);
    let borrow_day = 0;
    if diff_secs < 0 {
        diff_secs += 86400;
        borrow_day = 1;
    }

    let day = b[2] - a[2] - borrow_day;
    let cur_y = b[0];
    let cur_m = b[1];
    let borrow_month = 0;
    while day < 0 {
        cur_m -= 1;
        if cur_m < 1 {
            cur_m = 12;
            cur_y -= 1;
        }
        day += days_in_month(cur_y, cur_m);
        borrow_month += 1;
    }

    let month = b[1] - a[1] - borrow_month;
    let borrow_year = 0;
    while month < 0 {
        month += 12;
        borrow_year += 1;
    }

    [
        b[0] - a[0] - borrow_year,
        month,
        day,
        diff_secs / 3600,
        diff_secs % 3600 / 60,
        diff_secs % 60,
    ]
}

fn format_delta(parts, units, neg, zh) {
    let sign = if neg { "-" } else { "+" };
    let sep = if zh { "" } else { " " };
    let out = "";
    let first = true;
    let i = 0;
    while i < 6 {
        if parts[i] > 0 {
            out = if first {
                first = false;
                `${parts[i]}${units[i]}`
            } else {
                `${out}${sep}${parts[i]}${units[i]}`
            };
        }
        i += 1;
    }
    `${sign}${out}`
}

// 格式化两个归一化时刻之间（to - from）的历法差值，用于事件与实体基准时间的相对偏移展示。
pub fn delta_humanizer(ctx) {
    let from = ctx.from;
    let to = ctx.to;
    let zh = ctx.language == "zh";
    let units = if zh {
        ["年", "个月", "天", "小时", "分", "秒"]
    } else {
        ["y", "mo", "d", "h", "m", "s"]
    };

    if to.tick == from.tick {
        let p = if from.precision >= to.precision { from.precision } else { to.precision };
        let idx = if p < 1 { 0 } else if p > 6 { 5 } else { p - 1 };
        let zero = `0${units[idx]}`;
        return zero;
    }

    let neg = to.tick < from.tick;
    let parts = if neg {
        diff_components(to.values, from.values)
    } else {
        diff_components(from.values, to.values)
    };
    format_delta(parts, units, neg, zh)
}
