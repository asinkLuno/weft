# WEFT 故事文档示例

story {
  title            = "哈利·波特与魔法石"
  author           = "J.K. 罗琳"
  description      = """
    十一岁的哈利·波特进入霍格沃茨魔法学校，
    与同伴一起揭开魔法石的秘密。
  """
  calculable_props = {
    constellation = "constellation.rn"
  }
}

# ---- 1. 世界观与人物实体 ----

entity 霍格沃茨魔法学校 {
  kind        = "学校"
  description = "英国的魔法学校，下设四大学院。"
}

entity 格兰芬多 {
  kind        = "学院"
  description = "以勇气著称的学院，院徽为狮子。"
}

entity 斯莱特林 {
  kind        = "学院"
  description = "以野心著称的学院，院徽为蛇。"
}

entity 礼堂 {
  kind        = "地点"
  description = "霍格沃茨举行分院仪式与宴会的礼堂。"
}

entity 隐形衣 {
  kind        = "道具"
  description = "波特家世代相传的死亡圣器之一。"
}

entity 阿不思·邓布利多 {
  kind        = "人物"
  description = "霍格沃茨校长，巧克力蛙卡片上的著名巫师。"
  base_time   = 1881
}

entity 西弗勒斯·斯内普 {
  kind             = "人物"
  description      = "魔药课教师，讲话阴阳怪气，实则暗中保护哈利。"
  base_time        = [1960, 1, 9]
  calculable_props = [constellation]
}

entity 詹姆·波特 {
  kind             = "人物"
  description      = "哈利的父亲，格兰芬多击球手，掠夺者之首。"
  base_time        = [1960, 3, 27]
  calculable_props = [constellation]
}

entity 莉莉·波特 {
  kind             = "人物"
  description      = "哈利的母亲，麻瓜出身却天资出众的女巫。"
  base_time        = [1960, 1, 30]
  calculable_props = [constellation]
}

entity 哈利·波特 {
  kind             = "人物"
  description      = "大难不死的男孩，入学当晚被分入格兰芬多。"
  base_time        = [1980, 7, 31]
  calculable_props = [constellation]
  gender           = "男"
  wand             = "冬青木魔杖，凤凰羽毛杖芯"
}

entity 罗恩·韦斯莱 {
  kind             = "人物"
  description      = "哈利在火车上结识的好友，韦斯莱家幼子。"
  base_time        = [1980, 3, 1]
  calculable_props = [constellation]
}

entity 赫敏·格兰杰 {
  kind             = "人物"
  description      = "麻瓜出身、成绩拔尖的女巫，与哈利罗恩同窗。"
  base_time        = [1979, 9, 19]
  calculable_props = [constellation]
}

entity 德拉科·马尔福 {
  kind             = "人物"
  description      = "纯血世家出身的傲慢男生，被分入斯莱特林。"
  base_time        = [1980, 6, 5]
  calculable_props = [constellation]
}

entity 达力·德思礼 {
  kind             = "人物"
  description      = "哈利的表哥，住在女贞路四号。"
  base_time        = [1980, 6, 23]
  calculable_props = [constellation]
}

entity 汤姆·里德尔 {
  kind             = "人物"
  description      = "曾经的斯莱特林级长，后自称伏地魔。"
  base_time        = [1926, 12, 31]
  calculable_props = [constellation]
}

entity 伏地魔 {
  kind             = "人物"
  description      = "杀死哈利父母的黑魔王，人称「神秘人」。"
  base_time        = [1926, 12, 31]
  calculable_props = [constellation]
}

# ---- 2. 剧情点与叙事线 ----

event 分院帽晚宴 {
  start       = [1991, 9, 1, 19]
  end         = start + [0, 0, 0, 2]
  entities    = [
    哈利·波特,
    罗恩·韦斯莱,
    赫敏·格兰杰,
    德拉科·马尔福,
    西弗勒斯·斯内普,
    礼堂,
  ]
  description = "开学宴会上分院帽把新生分入四大学院，哈利伤疤因斯内普方向的视线首次灼痛。"
}

event 圣诞节礼物 {
  start       = [1991, 12, 25, 8]
  entities    = [哈利·波特, 隐形衣]
  description = "哈利在圣诞早晨收到匿名寄来的父亲遗物隐形衣。"
}

event 厄里斯魔镜 {
  start       = [1991, 12, 25, 21]
  entities    = [哈利·波特, 阿不思·邓布利多, 隐形衣]
  description = "圣诞夜哈利披着隐形衣夜游，在镜中看见了亡故的双亲。"
}

event 冥想盆真相 {
  start       = [1998, 5, 2, 3]
  entities    = [哈利·波特, 西弗勒斯·斯内普, 伏地魔]
  description = "哈利在冥想盆中看见斯内普的记忆，得知其毕生守护的真相。"
}

events 哈利的主线 = [分院帽晚宴, 圣诞节礼物, 厄里斯魔镜, 冥想盆真相]

# ---- 3. 实体时变关系图（状态层） ----

link 组织归属 {
  acyclic     = true
  transitive  = true
  description = "组织或阵营隶属关系（时变 DAG）"

  [格兰芬多, 斯莱特林, 阿不思·邓布利多] -> 霍格沃茨魔法学校
  西弗勒斯·斯内普 -> 斯莱特林
  [哈利·波特, 罗恩·韦斯莱, 赫敏·格兰杰] -> 格兰芬多 {
    start = 分院帽晚宴.start
  }
  德拉科·马尔福 -> 斯莱特林 {
    start = 分院帽晚宴.start
  }
}

link 空间 {
  acyclic     = true
  functional  = true
  description = "物理空间包含关系（严格树）"

  礼堂 -> 霍格沃茨魔法学校
}

link 物品持有 {
  inverse_functional = true
  description        = "唯一物品持有关系（同一时刻仅能由一人持有）"

  詹姆·波特 -> 隐形衣 {
    end = [1981, 10, 31]
  }
  哈利·波特 -> 隐形衣 {
    start = 圣诞节礼物.start
  }
}

link 人物关系 {
  description = "人际关系图（有向、无向、团自由混写，通过边标签区分语义）"

  莉莉·波特 <- "夫妻" -> 詹姆·波特
  哈利·波特 <- "表兄弟" -> 达力·德思礼
  <- "好友" -> [哈利·波特, 罗恩·韦斯莱, 赫敏·格兰杰]
  哈利·波特 -- "怀疑" -> 西弗勒斯·斯内普 {
    start       = 分院帽晚宴.start
    end         = 冥想盆真相.start
    description = "一直以为斯内普在帮伏地魔偷魔法石。"
  }
  哈利·波特 -- "致敬" -> 西弗勒斯·斯内普 {
    start = 冥想盆真相.end
  }
}

link 身份等价 {
  equivalence = true
  description = "身份等价关系（支持商图合并）"

  伏地魔 <-> 汤姆·里德尔
}

# ---- 4. 剧情拓扑图（伏笔与阻塞层） ----

link 剧情阻塞 {
  acyclic       = true
  chronological = true
  description   = "剧情前置解锁关系（防止道具或条件未就绪即触发后续剧情）"

  圣诞节礼物 -- "获得隐形衣" -> 厄里斯魔镜
}

link 伏笔 {
  acyclic       = true
  chronological = true
  description   = "跨章节伏笔埋设与回收链"

  分院帽晚宴 -- "伤疤灼痛与对斯内普的误判" -> 冥想盆真相
}
