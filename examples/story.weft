# WEFT 完整故事示例
#
# 《哈利·波特与魔法石》的节选示例：人物、地点、时间与剧情均取自
# tests/哈利·波特与魔法石/（全书十七章整理稿及其 story.weft），
# 仅保留代表性子集，演示 WEFT 六类声明的组织方式。

story {
  title            = "哈利·波特与魔法石"
  author           = "J.K. 罗琳"
  description      = """
    十一岁的哈利·波特进入霍格沃茨魔法学校，
    与同伴一起揭开魔法石的秘密。
  """
  calculable_props = {
    constellation = "constellation.rn"
  }
}

# =====================================================================
# 实体（kind 为自定义字段，自动收入 extra_props）
# 出生日期齐全的人物挂 constellation 可计算属性；
# 邓布利多只写到年份，星座将按插件约定静默缺席。
# =====================================================================

# —— 主角三人组 ——
entity 哈利·波特 {
  kind             = "人物"
  description      = "大难不死的男孩，额留闪电伤疤，寄居姨妈家碗柜十年，十一岁生日夜得知巫师身份；一年级即成为百年来最年轻的魁地奇找球手。"
  base_time        = [1980, 7, 31]
  calculable_props = [constellation]
}

entity 罗恩 {
  kind             = "人物"
  description      = "韦斯莱家第六个上霍格沃茨的孩子，哈利在特快上结识的挚友，巫师棋好手，用哥哥查理的旧魔杖。"
  base_time        = [1980, 3, 1]
  calculable_props = [constellation]
}

entity 赫敏 {
  kind             = "人物"
  description      = "麻瓜出身的一年级新生，开学前已背熟全部课本，成绩拔尖；巨怪事件后与哈利罗恩结为挚友。"
  base_time        = [1979, 9, 19]
  calculable_props = [constellation]
}

entity 纳威 {
  kind        = "人物"
  description = "圆脸健忘的同院同学，总弄丢蟾蜍，飞行课摔断手腕，年终因挺身阻拦三人而获得学院加分。"
}

# —— 同学 ——
entity 马尔福 {
  kind        = "人物"
  description = "纯血世家出身的傲慢同学，自称全家都从斯莱特林毕业，入学前就想拉拢哈利被拒，自此处处与三人组作对。"
}

# —— 教职员 ——
entity 阿不思·邓布利多 {
  kind             = "人物"
  description      = "霍格沃茨校长，魔法石的受托保管人；巧克力蛙画片记载他于一九四五年击败黑巫师格林德沃。"
  base_time        = 1881
  calculable_props = [constellation]
}

entity 麦格教授 {
  kind        = "人物"
  description = "霍格沃茨副校长，变形术教师兼格兰芬多院长，开学宴上主持分院，撞见哈利飞行后不罚反赏荐他为找球手。"
}

entity 斯内普教授 {
  kind             = "人物"
  description      = "魔药课教师兼斯莱特林院长，课上处处刁难哈利，腿伤成谜；当年被詹姆·波特救过性命，为还这份人情，一直在赛场念反咒暗中保护哈利。"
  base_time        = [1960, 1, 9]
  calculable_props = [constellation]
}

entity 奇洛教授 {
  kind        = "人物"
  description = "黑魔法防御术教师，说话结巴、总裹着头巾；环游世界时被伏地魔诱入麾下，伏地魔就附在他的后脑。"
}

entity 海格 {
  kind        = "人物"
  description = "钥匙保管员兼狩猎场看守，骑着摩托车把襁褓中的哈利送到女贞路；酒后向兜帽陌生人泄露了制服路威的秘密。"
}

# —— 反派与场外关键人物 ——
entity 伏地魔 {
  kind        = "人物"
  description = "杀害哈利父母的黑巫师，讳称「神秘人」；杀哈利时咒语失灵、形神俱损，靠独角兽血苟延残喘，附身奇洛潜回霍格沃茨谋取魔法石。"
}

entity 詹姆·波特 {
  kind             = "人物"
  description      = "哈利的父亲，当年霍格沃茨男生学生会主席，隐形衣是他的遗物；十年前万圣节前夕遇害。"
  base_time        = [1960, 3, 27]
  calculable_props = [constellation]
}

entity 莉莉·波特 {
  kind             = "人物"
  description      = "哈利的母亲，佩妮的妹妹，哈利继承了她的绿眼睛；牺牲前的母爱成为哈利最强大的护身符。"
  base_time        = [1960, 1, 30]
  calculable_props = [constellation]
}

entity 佩妮 {
  kind        = "人物"
  description = "哈利的姨妈，莉莉的姐姐，瘦削金发长脖子，绝口不提自家有女巫亲戚。"
}

entity 弗农·德思礼 {
  kind        = "人物"
  description = "哈利的姨父，格朗宁钻机公司主管，烧信、钉死信箱口、举家逃到海上礁石，只为躲开霍格沃茨的信。"
}

entity 达力 {
  kind             = "人物"
  description      = "德思礼夫妇娇纵的独子，生日收三十九件礼物、还嫌少两件，动物园那天被海格变出一条猪尾巴。"
  base_time        = [1980, 6, 23]
  calculable_props = [constellation]
}

entity 尼可·勒梅 {
  kind        = "人物"
  description = "魔法石的惟一制造者，隐居德文郡的炼金术士，去年刚庆祝六百六十五岁生日；与邓布利多至交，石头销毁后他将平静赴死。"
}

entity 费伦泽 {
  kind        = "人物"
  description = "禁林里的白金色年轻马人，让哈利骑在背上救了他，并点破饮独角兽血者正是伏地魔。"
}

# —— 团体 ——
entity 霍格沃茨魔法学校 {
  kind        = "团体"
  description = "世界上最优秀的魔法学校，学期每年九月一日开始，下设四大学院，楼梯会动、幽灵游荡。"
}

entity 格兰芬多 {
  kind        = "团体"
  description = "四学院之一，崇尚勇气，多年未得学院杯，年终宴会上靠最后一刻的加分逆转夺魁。"
}

entity 斯莱特林 {
  kind        = "团体"
  description = "四学院之一，据说变坏的巫师多出于此，连年蝉联学院杯，直到年终宴会被格兰芬多反超。"
}

# —— 地点 ——
entity 高锥克山谷 {
  kind        = "地点"
  description = "波特一家生前居住的村庄，伏地魔在此杀害了詹姆和莉莉。"
}

entity 女贞路四号 {
  kind        = "地点"
  description = "德思礼家的住址，襁褓中的哈利被放在门前台阶上，一住十年。"
}

entity 礁石上的小屋 {
  kind        = "地点"
  description = "海上礁石里的破屋，德思礼一家躲信件的尽头，海格在暴风雨夜破门而入。"
}

entity 对角巷 {
  kind        = "地点"
  description = "破釜酒吧后墙通往的鹅卵石巫师商业街，摩金夫人长袍店、奥利凡德魔杖店与丽痕书店所在。"
}

entity 古灵阁 {
  kind        = "地点"
  description = "妖精经营的巫师银行，深入伦敦地下数百英里；七月三十一日曾发生一起未遂闯入。"
}

entity "9又3/4站台" {
  kind        = "地点"
  description = "国王十字车站第9、10站台之间的魔法检票口，径直冲过即登霍格沃茨特快。"
}

entity 礼堂 {
  kind        = "地点"
  description = "四张长桌与漂浮蜡烛的大厅，天花板施咒如夜空，开学宴、万圣节宴与年终宴会都在此举行。"
}

entity 女厕所 {
  kind        = "地点"
  description = "赫敏躲起来哭的地方，万圣节夜的巨怪在这里被打昏。"
}

entity 魁地奇球场 {
  kind        = "地点"
  description = "看台环绕的球场，两端立着五十英尺高的金色球门柱。"
}

entity 禁林 {
  kind        = "地点"
  description = "校园边缘的禁地，独角兽接连遇害，哈利在此撞见啜饮独角兽血的兜帽身影。"
}

entity 猪头酒吧 {
  kind        = "地点"
  description = "霍格沃茨村里的酒吧，光顾者古怪；海格正是在这里被兜帽陌生人灌醉，套走了制服路威的方法。"
}

# —— 道具与动物 ——
entity 隐形衣 {
  kind        = "道具"
  description = "哈利父亲的遗物，圣诞节清晨匿名送还，附字条「你父亲死前留下这件东西给我」，探病时揭晓是邓布利多所为。"
}

entity 厄里斯魔镜 {
  kind        = "道具"
  description = "照出内心最深渴望的魔镜，哈利在镜中看见亡故的家人；邓布利多后来把它改造成藏匿魔法石的机关。"
}

entity 魔法石 {
  kind        = "道具"
  description = "点石成金、炼出长生不老药的奇迹之石，尼可·勒梅的惟一杰作；先藏于古灵阁713号金库，后移入霍格沃茨地下，年终与勒梅商定销毁。"
}

entity 哈利的魔杖 {
  kind        = "道具"
  description = "冬青木、十一英寸、凤凰羽毛杖芯——与伏地魔的紫杉木杖出自同一只凤凰，兄弟魔杖。"
}

entity 分院帽 {
  kind        = "道具"
  description = "会唱会想的旧巫师帽，决定新生去哪个学院；它本想把哈利分入斯莱特林，依他的意愿改判格兰芬多。"
}

entity 光轮2000 {
  kind        = "道具"
  description = "麦格教授匿名送给哈利的最新款飞天扫帚，首赛中疑遭恶咒而疯狂甩动。"
}

entity 记忆球 {
  kind        = "道具"
  description = "握紧时变红即提示忘事；纳威被马尔福抢走的正是它，哈利俯冲接住而入魁地奇队。"
}

entity 海德薇 {
  kind        = "动物"
  description = "海格在对角巷送哈利的十一岁生日礼物，一只雪鸮，名字取自《魔法史》，替他往来送信。"
}

entity 巨怪 {
  kind        = "动物"
  description = "万圣节夜闯进城堡的十二英尺巨怪，在女厕所被罗恩用漂浮咒打昏。"
}

# =====================================================================
# 实体关系（按组组织）
# =====================================================================

link 组织归属 {
  acyclic     = true
  transitive  = true
  description = "组织或阵营隶属关系（时变 DAG）"

  [格兰芬多, 斯莱特林] -> 霍格沃茨魔法学校
  [
    阿不思·邓布利多,
    麦格教授,
    斯内普教授,
    奇洛教授,
    海格,
  ] -> 霍格沃茨魔法学校
  [阿不思·邓布利多, 麦格教授] -> 格兰芬多
  斯内普教授 -> 斯莱特林
  [哈利·波特, 罗恩, 赫敏, 纳威] -> 格兰芬多 {
    start = 开学宴分院.start
  }
  马尔福 -> 斯莱特林 {
    start = 开学宴分院.start
  }
}

link 空间 {
  acyclic     = true
  functional  = true
  description = "物理空间包含关系（严格树）"

  礼堂 -> 霍格沃茨魔法学校
}

link 物品持有 {
  inverse_functional = true
  description        = "唯一物品持有关系（同一时刻仅能由一人持有）"

  詹姆·波特 -> 隐形衣 {
    end = [1981, 10, 31]
  }
  哈利·波特 -> 隐形衣 {
    start = 圣诞礼物隐形衣.start
  }
}

link 波特一家 {
  哈利·波特 -- "母子" -> 莉莉·波特
  哈利·波特 -- "父子" -> 詹姆·波特
  莉莉·波特 <- "夫妻" -> 詹姆·波特
}

link 德思礼一家 {
  弗农·德思礼 <- "夫妻" -> 佩妮
  达力 -- "父子" -> 弗农·德思礼
  达力 -- "母子" -> 佩妮
  哈利·波特 -- "姨母与外甥" -> 佩妮
  哈利·波特 -- "姨父与外甥" -> 弗农·德思礼
  哈利·波特 -- "表兄弟" -> 达力
}

link 主角三人组 {
  <- "挚友" -> [哈利·波特, 罗恩, 赫敏] {
    start = 万圣节巨怪入侵.start
  }
}

link 旧日恩怨 {
  詹姆·波特 -- "当年救命之恩，斯内普为还人情暗中护哈利" -> 斯内普教授
}

link 师长与学生 {
  哈利·波特 -- "校长与学生" -> 阿不思·邓布利多
  哈利·波特 -- "院长与学生，破格荐为找球手" -> 麦格教授
  哈利·波特 -- "表面苛待，暗中保护" -> 斯内普教授
  哈利·波特 -- "忘年朋友" -> 海格
  阿不思·邓布利多 -- "至交，共守魔法石" -> 尼可·勒梅
}

link 敌对 {
  马尔福 -- "死对头" -> 哈利·波特
  伏地魔 -- "杀亲之仇" -> 哈利·波特
  伏地魔 -- "惟一惧怕的人" -> 阿不思·邓布利多
  奇洛教授 -- "效忠并被附身" -> 伏地魔
}

link 魔法石与圣物 {
  尼可·勒梅 -- "制造者" -> 魔法石
  阿不思·邓布利多 -- "受托保管" -> 魔法石
  哈利·波特 -- "魔杖认主（与伏地魔兄弟杖芯）" -> 哈利的魔杖 {
    start = 对角巷购物.start
  }
}

link 伙伴与动物 {
  海德薇 -- "信使猫头鹰" -> 哈利·波特
}

# =====================================================================
# 事件（跨事件直接引用时间锚点并做 +/- 偏移运算）
# =====================================================================

event 伏地魔袭击高锥克山谷 {
  start       = [1981, 10, 31] # 十年前万圣节前夕
  entities    = [伏地魔, 詹姆·波特, 莉莉·波特, 哈利·波特, 高锥克山谷]
  description = "伏地魔上门袭击：詹姆持杖搏斗身亡，莉莉拼死护子被杀；杀咒在一岁哈利身上失灵、伏地魔本人形神俱损，哈利只留下闪电伤疤。"
}

event 哈利被放到女贞路四号 {
  start       = 伏地魔袭击高锥克山谷.start + [0, 0, 1] # 次日午夜
  entities    = [阿不思·邓布利多, 麦格教授, 海格, 哈利·波特, 女贞路四号]
  description = "邓布利多、麦格与海格把襁褓中的哈利连同信放在姨父家门口台阶上，随后各自离去。"
}

event 首封霍格沃茨来信 {
  start       = 海格午夜送信.start - [0, 0, 7] # 倒推一周
  entities    = [哈利·波特, 弗农·德思礼, 佩妮]
  description = "写着「楼梯下的碗柜」的绿墨水信寄到，被弗农抢走；此后信件与日俱增。"
}

event 信件洪流与举家出逃 {
  start       = 海格午夜送信.start - [0, 0, 2]
  entities    = [哈利·波特, 弗农·德思礼, 佩妮, 达力]
  description = "几十封信从壁炉喷进厨房，弗农当即带全家开车出逃，当夜宿铁路风景旅馆。"
}

event 躲进礁石上的小屋 {
  start       = 海格午夜送信.start - [0, 0, 1]
  entities    = [哈利·波特, 弗农·德思礼, 佩妮, 达力, 礁石上的小屋]
  description = "全家乘船躲进海上礁石破屋，暴雨之夜，午夜将至时屋门被撞响。"
}

event 海格午夜送信 {
  start       = 哈利·波特.base_time + [11] # 哈利十一岁生日零点
  entities    = [海格, 哈利·波特, 弗农·德思礼, 佩妮, 达力, 礁石上的小屋]
  description = "生日零点海格破门而入，送达霍格沃茨录取信；告知哈利身世——父母并非死于车祸，并施法让达力长出猪尾巴。"
}

event 对角巷购物 {
  start       = 海格午夜送信.start + [0, 0, 1]
  entities    = [哈利·波特, 海格, 奇洛教授, 马尔福, 对角巷, 古灵阁]
  description = "海格带哈利经破釜酒吧进对角巷：古灵阁取父母遗产并替邓布利多取出713号金库的神秘小包；摩金夫人店遇马尔福；冬青木魔杖在奥利凡德店选中哈利，海格还在咿啦猫头鹰商店买了海德薇。"
}

event 开学宴分院 {
  start       = [1991, 9, 1, 19]
  end         = start + [0, 0, 0, 2] # 宴会两小时后结束
  entities    = [
    哈利·波特,
    罗恩,
    赫敏,
    纳威,
    马尔福,
    麦格教授,
    阿不思·邓布利多,
    分院帽,
    礼堂,
  ]
  description = "分院帽把哈利罗恩赫敏纳威分入格兰芬多、马尔福入斯莱特林；宴上哈利伤疤随斯内普的注视首次灼痛，邓布利多宣布禁林与四楼右侧走廊禁令。"
}

event 飞行课夺回记忆球 {
  start       = [1991, 9, 12, 15, 30]
  entities    = [哈利·波特, 马尔福, 纳威, 麦格教授, 记忆球]
  description = "飞行课上纳威失控坠地摔断手腕，马尔福抢其记忆球上空挑衅，哈利无师自通俯冲接回；麦格教授不罚反赏，破格荐他为格兰芬多找球手。"
}

event 光轮2000送达 {
  start       = 飞行课夺回记忆球.start + [0, 0, 7] # 大约一个星期后
  entities    = [哈利·波特, 麦格教授, 光轮2000]
  description = "匿名包裹送来光轮2000，附麦格字条；当晚开始魁地奇训练。"
}

event 万圣节巨怪入侵 {
  start       = [1991, 10, 31, 18]
  entities    = [哈利·波特, 罗恩, 赫敏, 奇洛教授, 巨怪, 礼堂, 女厕所]
  description = "万圣节晚宴上奇洛报称巨怪进入地下教室后昏倒；哈利罗恩赶往女厕所打昏巨怪救出赫敏，三人自此结为朋友；疏散途中哈利瞥见斯内普独自溜向三楼禁区。"
}

event 魁地奇比赛扫帚失控 {
  start       = [1991, 11, 9, 11]
  entities    = [哈利·波特, 斯内普教授, 赫敏, 罗恩, 海格, 魁地奇球场]
  description = "首战斯莱特林：哈利扫帚疯狂甩动疑遭暗算，赫敏火烧斯内普袍角破解，哈利险些吞住飞贼后反败为胜，170比60。"
}

event 圣诞礼物隐形衣 {
  start       = [1991, 12, 25, 8]
  entities    = [哈利·波特, 罗恩, 隐形衣]
  description = "哈利平生第一次收到圣诞礼物，其中匿名送来的隐形衣附无署名字条，称是其父遗物「现在应该归还给你」。"
}

event 初见厄里斯魔镜 {
  start       = [1991, 12, 25, 21]
  entities    = [哈利·波特, 厄里斯魔镜]
  description = "哈利披隐形衣夜探禁书区，躲过费尔奇与斯内普，在废弃教室的镜中看见亡故的父母和亲人。"
}

event 邓布利多解释魔镜 {
  start       = 初见厄里斯魔镜.start + [0, 0, 2] # 第三晚
  entities    = [哈利·波特, 阿不思·邓布利多, 厄里斯魔镜]
  description = "邓布利多点破魔镜映现的是人内心最深的渴望，嘱咐哈利勿再沉迷，次日把镜子搬走。"
}

event 发现尼可·勒梅 {
  start       = [1992, 1]
  entities    = [哈利·波特, 罗恩, 赫敏, 尼可·勒梅, 魔法石]
  description = "哈利从邓布利多的巧克力蛙画片上认出勒梅之名，赫敏翻书确认他是魔法石的惟一制造者——路威看守的正是魔法石。"
}

event 海格赢回龙蛋 {
  start       = [1992, 4]
  entities    = [海格, 猪头酒吧]
  description = "海格在村里的猪头酒吧与兜帽陌生人玩牌，「赢」下一只挪威脊背龙蛋，藏在炉火里孵着。"
}

event 禁林禁闭遇伏地魔 {
  start       = [1992, 5, 26, 23]
  entities    = [哈利·波特, 伏地魔, 费伦泽, 禁林]
  description = "禁林禁闭分头寻找受伤的独角兽，哈利撞见兜帽身影啜饮独角兽血、伤疤剧痛；马人费伦泽救下他并点破那是伏地魔。"
}

event 醒悟龙蛋圈套 {
  start       = [1992, 6, 4, 14] # 期末考试最后一天下午
  entities    = [哈利·波特, 罗恩, 赫敏, 海格, 猪头酒吧]
  description = "最后一门考完，哈利醒悟兜帽陌生人是在猪头酒吧以龙蛋为饵，套走了制服路威的方法；海格承认当晚被灌醉后说漏了嘴。"
}

event 邓布利多被骗往伦敦 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 0, 0, 3]
  entities    = [阿不思·邓布利多, 麦格教授, 哈利·波特]
  description = "一封魔法部紧急信件把邓布利多调往伦敦；哈利向麦格教授示警有人今夜要偷魔法石，未被理会。"
}

event 深夜穿越活板门 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 0, 9]
  entities    = [哈利·波特, 罗恩, 赫敏, 纳威, 隐形衣]
  description = "纳威拦阻不成反被赫敏定身；三人披隐形衣、用海格自制的笛声催眠三头犬穿过活板门，连闯魔鬼网、飞天钥匙、巨型棋盘阵——罗恩牺牲自己将死对方昏倒，赫敏折返求援，哈利独自进入最后一个房间。"
}

event 地牢最终对决 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 0, 12]
  entities    = [哈利·波特, 奇洛教授, 伏地魔, 阿不思·邓布利多, 厄里斯魔镜, 魔法石]
  description = "最后房间里是双面人奇洛——伏地魔附在其后脑；哈利从魔镜中取得魔法石，徒手触碰令奇洛溃烂，伏地魔弃躯出逃，邓布利多及时赶到把奇洛拉开。"
}

event 探病揭秘 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 3]
  entities    = [阿不思·邓布利多, 哈利·波特, 魔法石]
  description = "邓布利多探视揭晓：奇洛已死，魔法石已与勒梅商定销毁，救哈利的是母亲牺牲留下的爱之护符，圣诞夜隐形衣的匿名赠与者正是邓布利多本人。"
}

event 年终宴会逆转夺杯 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 4, 6]
  entities    = [阿不思·邓布利多, 哈利·波特, 罗恩, 赫敏, 纳威, 礼堂]
  description = "邓布利多在最后时刻为罗恩、赫敏、哈利、纳威加分，格兰芬多以一分反超，七年来首夺学院杯。"
}

event 学年结束返家 {
  start       = 醒悟龙蛋圈套.start + [0, 0, 5, 10]
  entities    = [哈利·波特, 罗恩, 赫敏, 弗农·德思礼, 佩妮, 达力, "9又3/4站台"]
  description = "乘船渡湖、登上霍格沃茨特快回到国王十字车站，哈利被德思礼一家接走，与罗恩赫敏约定暑假再见。"
}

