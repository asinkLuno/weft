// 星座：可计算属性示例。
// calculable_prop 接收实体上下文，直接返回当前语言的星座名，
// 宿主把返回值写进实体 extra_props 的 constellation 键下。

fn sign_names(zh) {
    if zh {
        ["摩羯座", "水瓶座", "双鱼座", "白羊座", "金牛座", "双子座",
         "巨蟹座", "狮子座", "处女座", "天秤座", "天蝎座", "射手座"]
    } else {
        ["Capricorn", "Aquarius", "Pisces", "Aries", "Taurus", "Gemini",
         "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius"]
    }
}

pub fn calculable_prop(ctx) {
    let zh = ctx.language == "zh";
    if ctx.date_mode != () {
        let message = if zh {
            `计算星座需要公历，当前历法是 ${ctx.date_mode}`
        } else {
            `constellation requires a Gregorian calendar, got ${ctx.date_mode}`
        };
        panic(message);
    }
    let bt = ctx.entity.base_time;
    if bt == () {
        let message = if zh {
            `实体 ${ctx.entity.id} 没有 base_time，无法计算星座`
        } else {
            `entity ${ctx.entity.id} has no base_time, cannot compute the constellation`
        };
        panic(message);
    }
    let month = bt[1];
    let day = bt[2];
    if month < 1 || month > 12 || day < 1 {
        let message = if zh {
            `实体 ${ctx.entity.id} 的 base_time 至少要写全 年月日，才能计算星座`
        } else {
            `entity ${ctx.entity.id} needs at least year/month/day in base_time`
        };
        panic(message);
    }
    let cutoff = [20, 19, 21, 20, 21, 22, 23, 23, 23, 24, 23, 22];
    sign_names(zh)[(month - 1 + if day >= cutoff[month - 1] { 1 } else { 0 }) % 12]
}
