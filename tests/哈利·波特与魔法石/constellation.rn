// 星座：可计算属性示例。
// calculable_prop 接收实体上下文，直接返回当前语言的星座名，
// 宿主把返回值写进实体 extra_props 的 constellation 键下。

fn sign_names(zh) {
    if zh {
        ["摩羯座", "水瓶座", "双鱼座", "白羊座", "金牛座", "双子座",
         "巨蟹座", "狮子座", "处女座", "天秤座", "天蝎座", "射手座"]
    } else {
        ["Capricorn", "Aquarius", "Pisces", "Aries", "Taurus", "Gemini",
         "Cancer", "Leo", "Virgo", "Libra", "Scorpio", "Sagittarius"]
    }
}

// 星座只认公历的月、日分量；换了历法这两位的含义就变了，宁可报错也不给错值。
// 用 match 而不用 if：if 分支里的 panic 会被推断成 unit，整个函数返回类型报错，
// 消息反而丢了；match 的分支才会把 panic 直接抛给宿主。
fn require_gregorian(date_mode, zh) {
    match date_mode {
        () => (),
        path => {
            let message = if zh {
                `计算星座需要公历，当前历法是 ${path}`
            } else {
                `constellation requires a Gregorian calendar, got ${path}`
            };
            panic(message)
        }
    }
}

pub fn calculable_prop(ctx) {
    let zh = ctx.language == "zh";
    require_gregorian(ctx.date_mode, zh);
    let bt = ctx.entity.base_time;
    // 没写 base_time 的实体没有星座。数据不齐不算错误，返回 () 让它不写入，
    // 这样同一个属性可以整批挂到所有实体上，不必逐个筛查谁写了日期。
    if bt == () {
        return ();
    }
    let month = bt[1];
    let day = bt[2];
    let cutoff = [20, 19, 21, 20, 21, 22, 23, 23, 23, 24, 23, 22];
    sign_names(zh)[(month - 1 + if day >= cutoff[month - 1] { 1 } else { 0 }) % 12]
}
