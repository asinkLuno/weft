{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weft",
  "version": "0.2.0",
  "identifier": "com.guozr.weft",
  "build": {
    "beforeDevCommand": "yarn prepare:cli && yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn prepare:cli && yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WEFT",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 WEFT Contributors",
    "externalBin": [
      "binaries/weft"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "./windows/cli-path.wxs"
        ],
        "componentRefs": [
          "WeftCliPath"
        ]
      }
    }
  }
}
