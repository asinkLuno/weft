// 公历日期分量：[年, 月, 日, 时, 分, 秒]。历算与本地化展示分开。
pub fn components() { 6 }

// 反算 tick；用整段日期换算处理跨月、跨年及负的时分秒。
pub fn from_tick(tick) {
    // 历算以三月为年首；将零年一月一日原点移回三月基准。
    let tick = tick - 60 * 86400;
    let days = tick / 86400;
    let seconds = tick % 86400;
    if seconds < 0 {
        days -= 1;
        seconds += 86400;
    }
    let era = if days >= 0 { days / 146097 } else { (days - 146096) / 146097 };
    let doe = days - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let year = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = doy - (153 * mp + 2) / 5 + 1;
    let month = mp + if mp < 10 { 3 } else { -9 };
    year += if month <= 2 { 1 } else { 0 };
    [year, month, day, seconds / 3600, seconds % 3600 / 60, seconds % 60]
}

// 日期相对原点的秒数。全零数组和 [0, 1, 1, 0, 0, 0] 对应 0。
// 两个日期的刻度相减得到间隔秒数；除以 86400 得到相差天数。
pub fn to_tick(values) {
    let year = values[0];
    // 缺省月、日按一月一日计算。
    let month = if values[1] == 0 { 1 } else { values[1] };
    let day = if values[2] == 0 { 1 } else { values[2] };
    let hour = values[3];
    let minute = values[4];
    let second = values[5];

    let raw_month_idx = (month - 1) % 12;
    let month_idx = if raw_month_idx < 0 { raw_month_idx + 12 } else { raw_month_idx };
    let year_carry = ((month - 1) - month_idx) / 12;
    year += year_carry;
    let month = month_idx + 1;

    let total_seconds = hour * 3600 + minute * 60 + second;
    let day_carry = total_seconds / 86400;
    let seconds = total_seconds % 86400;

    let adjusted_year = year - if month <= 2 { 1 } else { 0 };
    let era = if adjusted_year >= 0 {
        adjusted_year / 400
    } else {
        (adjusted_year - 399) / 400
    };
    let yoe = adjusted_year - era * 400;
    let shifted_month = month + if month > 2 { -3 } else { 9 };
    let doy = (153 * shifted_month + 2) / 5;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy + day - 1 + day_carry;
    (era * 146097 + doe + 60) * 86400 + seconds
}

pub fn serialize(lang) {
    let zh = lang == "zh";
    #{
        name: if zh { "格里高利历" } else { "Gregorian Calendar" },
        description: if zh {
            "采用年、月、日和时分秒表示时间，并包含公历闰年规则。"
        } else {
            "Represents time with years, months, days, hours, minutes, and seconds."
        },
    }
}

// 只格式化 normalize 后的日期，不参与历算。
pub fn humanizer(value, lang) {
    let year = value[0];
    let month = value[1];
    let day = value[2];
    let hour = value[3];
    let minute = value[4];
    let second = value[5];
    if lang == "zh" {
        let date = `${year}年${month}月${day}日`;
        if hour == 0 && minute == 0 && second == 0 { return date; }
        let stamp = `${date}${hour}时${minute}分${second}秒`;
        return stamp;
    }
    let months = ["Jan.", "Feb.", "Mar.", "Apr.", "May", "Jun.", "Jul.", "Aug.", "Sep.", "Oct.", "Nov.", "Dec."];
    let date = `${months[month - 1]} ${day}, ${year}`;
    if hour == 0 && minute == 0 && second == 0 { return date; }
    let hh = if hour < 10 { `0${hour}` } else { `${hour}` };
    let mm = if minute < 10 { `0${minute}` } else { `${minute}` };
    let ss = if second < 10 { `0${second}` } else { `${second}` };
    `${date}, ${hh}:${mm}:${ss}`
}
