# 机房迁移草稿（包含多处待修问题）

story {
  title = "核心机房迁移"
  author = 运维团队
  version = 2
}

time 割接窗口 = [2026, 6, 18, 2]
time 废弃锚点 = [2026, 1, 1]

entity 2号机房 {
  description = "新投入使用的同城灾备机房"
}

entity 华东集群 {
  description = "华东区核心生产集群"
}

entity 订单服务 {
  description = "核心交易订单处理服务"
  base_time = [2023, 0, 10]
  tier = "P0"
}

entity 网关集群 {
  description = "统一入口流量转发层"
}

entity 未接入组件 {
  description = "顺手写上的旧模块，未在事件和关系中使用"
}

link 机房归属 {
  acyclic = true

  2号机房 -> 华东集群
  华东集群 -> 2号机房
  [订单服务, 网关集群] -> 2号机房
}

link 调用拓扑 {
  asymmetric = true

  网关集群 -- 转发 -> 订单服务
  网关集群 -- "转发" -> 订单服务
}

link 空拓扑 {
  transitive = true
}

link 变更前置 {
  acyclic = true
  chronological = true

  回归验收 -> 停机割接
}

event 停机割接 {
  start = 割接窗口
  end = 割接窗口 - [0, 0, 0, 2]
  env = "prod"
  entities = [订单服务, 网关集群, 2号机房]
  description = "停止写入并同步最后一批增量数据。"
}

event 回归验收 {
  start = 停机割接.start + [0, 0, 0, 1]
  end = start + [0, 0, 0, 3]
  entities = [网关集群, 2号机房]
  description = "切流后执行全链路压测与核心指标巡检。"
}

events 迁移主线 = [停机割接]
